SYNCMESH_NODE_ID=node-a
SYNCMESH_DB_PATH=data/node-a/node.db
SYNCMESH_PEERS=http://node-b:8000,http://node-c:8000
SYNCMESH_SYNC_INTERVAL_SECONDS=5
SYNCMESH_SYNC_BYTE_BUDGET=65536
SYNCMESH_CORS_ORIGINS=http://localhost:5173
SYNCMESH_ENVIRONMENT=dev
# Required when SYNCMESH_ENVIRONMENT=production. Generate independent secrets.
# SYNCMESH_ADMIN_TOKEN=replace-with-a-long-random-token
# SYNCMESH_PEER_SECRET=replace-with-a-long-random-peer-secret
